<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Nullable>enable</Nullable>
    <!-- 源码物理位置在 Assets/Scripts/Simulation（Unity asmdef 侧），此处显式包含同一份源码 -->
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ScpSourceRoot>$(MSBuildThisFileDirectory)../../Assets/Scripts/Simulation/</ScpSourceRoot>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Scp.Domain\Scp.Domain.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="$(ScpSourceRoot)**\*.cs" />
  </ItemGroup>

</Project>
